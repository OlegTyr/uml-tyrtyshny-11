@startuml
!include ../../_style.puml

class НаборТестов {
  + название : String
  + язык : String
}

class Тест {
  + имя : String
  + файл : String
}

class Прогон {
  + датаСтарта : DateTime
  + статус : СтатусПрогона
}

class РезультатТеста {
  + статус : СтатусТеста
  + длительность : int
}

enum СтатусПрогона {
  В_ОЧЕРЕДИ
  ИДЁТ
  УСПЕХ
  ПРОВАЛ
}

НаборТестов "1" *-- "0..*" Тест
НаборТестов "1" -- "0..*" Прогон
Прогон "1" *-- "0..*" РезультатТеста
Тест "1" -- "0..*" РезультатТеста
@enduml