@startuml
!include ../../_style.puml
title Система автоматического тестирования: модель предметной области
hide circle

package "catalog" {
  class Проект {
    + название : String
  }

  class НаборТестов {
    + название : String
    - язык : String
    + тесты() : List<Тест>
  }

  class Тест {
    + id : UUID
    + имя : String
    + файл : String
    + флаки : boolean
    + пометитьФлаки(причина : String) : void
  }

  class Расписание {
    + cron : String
    + активнo : boolean
  }

  class ПолитикаФлаки {
    + порог : double
    + минПрогонов : int
    + этоФлаки(история : List<РезультатТеста>) : boolean
  }
}

package "execution" {
  abstract class Исполнитель {
    + id : String
    {abstract} + выполнить(набор : НаборТестов) : Прогон
  }

  class RunnerАгент {
    + имя : String
    - статус : СтатусАгента
  }

  class Прогон {
    + id : UUID
    + датаСтарта : DateTime
    + датаФиниша : DateTime
    + статус : СтатусПрогона
    + длительность() : int
    + предыдущийПрогон : UUID
  }

  class РезультатТеста {
    + статус : СтатусТеста
    + длительность : int
    + лог : String
  }

  class ИсторияПрогонов {
    + заПериод(с : Date, по : Date) : List<Прогон>
    + поНабору(набор : НаборТестов) : List<Прогон>
  }

  enum СтатусПрогона {
    В_ОЧЕРЕДИ
    НАЗНАЧЕН
    ИДЁТ
    УСПЕХ
    ПРОВАЛ
    ПРЕРВАН
    ОТМЕНЁН
  }

  enum СтатусТеста {
    ПРОЙДЕН
    УПАЛ
    ПРОПУЩЕН
    ТАЙМАУТ
  }

  enum СтатусАгента {
    СВОБОДЕН
    ЗАНЯТ
    ОФЛАЙН
  }
}

' --- Обобщение ---
RunnerАгент --|> Исполнитель

' --- Композиция: тест умирает вместе с набором ---
НаборТестов "1" *-- "1..*" Тест : содержит

' --- Агрегация: набор переживает проект ---
Проект "0..1" o-- "0..*" НаборТестов : объединяет

' --- Ассоциации с кратностями ---
НаборТестов "1" -- "0..*" Прогон : порождает
Прогон "1" *-- "0..*" РезультатТеста : фиксирует
Тест "1" -- "0..*" РезультатТеста : имеет
RunnerАгент "1" -- "0..*" Прогон : выполняет
НаборТестов "1" -- "0..1" Расписание : настраивается
Тест "0..*" -- "1" ПолитикаФлаки : оценивается

' --- Зависимости ---
ИсторияПрогонов ..> Прогон : <<use>>
ПолитикаФлаки ..> РезультатТеста : <<use>>
execution ..> catalog : <<use>>
@enduml