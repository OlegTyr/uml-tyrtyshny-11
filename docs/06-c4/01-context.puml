@startuml
!include <C4/C4_Context>
title Уровень 1 – System Context: Система автоматического тестирования

Person(dev, "Разработчик", "Запускает тесты, смотрит отчёты")
Person(admin, "Администратор", "Настраивает расписание, размечает флаки")

System(testing, "Система автоматического тестирования", "Запуск тестов, история прогонов, отчёты")

System_Ext(ci, "CI-система", "Триггерит прогоны на каждый коммит")
System_Ext(notify, "Система уведомлений", "Slack / почта")

Rel(dev, testing, "Запускает тесты и смотрит отчёты", "HTTPS")
Rel(admin, testing, "Настраивает расписание и флаки", "HTTPS")
Rel(ci, testing, "Триггерит прогоны", "REST/HTTPS")
Rel(testing, notify, "Отправляет уведомления о завершении", "HTTPS")

SHOW_LEGEND()
@enduml