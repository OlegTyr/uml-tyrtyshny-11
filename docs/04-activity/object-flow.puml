@startuml
!include ../../_style.puml
title Поток объекта «Прогон» в процессе тестирования

start
:Получить запрос на запуск;
:Прогон [В_ОЧЕРЕДИ]/; <<object>>
:Назначить агент;
:Прогон [НАЗНАЧЕН]/; <<object>>
:Выполнить тесты;
:Прогон [ИДЁТ]/; <<object>>

if (Отменён пользователем?) then (да)
  :Остановить агент;
  :Прогон [ОТМЕНЕН]/; <<object>>
  :Зафиксировать причину;
  stop
elseif (Все тесты прошли?) then (да)
  :Прогон [УСПЕХ]/; <<object>>
  :Отправить уведомление;
  :Зафиксировать итог;
  stop
else (нет)
  :Прогон [ПРОВАЛ]/; <<object>>
  :Отправить уведомление;
  :Зафиксировать итог;
  stop
endif

@enduml 
